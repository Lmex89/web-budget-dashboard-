# Local development — use localhost:3308 (Docker exposes MariaDB on this host port)
DATABASE_URL=mysql+aiomysql://budget_user:budget_pass@localhost:3308/family_budget
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
LOG_LEVEL=INFO
ENVIRONMENT=development

# Multi-tenancy: if true, injects family_id predicate into every SELECT on
# tenant-owned models (defense-in-depth). Start false, enable after staging validation.
ENABLE_GLOBAL_TENANT_GUARD=false

# Email (local dev logs emails instead of sending them).
# Switch to EMAIL_PROVIDER=brevo and set BREVO_API_KEY/EMAIL_FROM_EMAIL to send for real.
EMAIL_PROVIDER=console
EMAIL_FROM_EMAIL=no-reply@example.com
EMAIL_FROM_NAME="Family Budget"
APP_BASE_URL=http://localhost:5173

# For Docker deployment, these values live in /.env.docker (gitignored).
# docker-compose.yml loads that file via env_file for every service.
