# Default admin credentials (created by seed.py)
# Email:    admin@family.com
# Password: admin123

# Database
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=family_budget
MYSQL_USER=budget_user
MYSQL_PASSWORD=budget_pass

# Backend
DATABASE_URL=mysql+aiomysql://budget_user:budget_pass@db:3306/family_budget
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_CORS_ORIGINS=http://localhost:5173,http://192.168.68.53:5173

# Multi-tenancy: if true, injects family_id predicate into every SELECT on
# tenant-owned models (defense-in-depth). Start false, enable after staging validation.
ENABLE_GLOBAL_TENANT_GUARD=false

# Frontend
VITE_API_BASE_URL=http://192.168.68.53:8003

# Timezone (set on db + backend services in docker-compose.yml)
# Default: America/Merida
TIMEZONE=America/Merida

# Backblaze B2 cloud backup (used by backup-db.sh; optional)
# Create an app key at https://secure.backblaze.com/b2_buckets.htm#show-app-keys
# BACK_BLAZE_KEY_ID  — B2 Application Key ID (the long alphanumeric id, not the key itself)
# BACK_BLAZE_SECRET   — B2 Application Key (the K005... secret)
BACK_BLAZE_KEY_ID=
BACK_BLAZE_SECRET=
BACK_BLAZE_BUCKET=lmex-backups-db
BACK_BLAZE_DIR=web-budget-family
